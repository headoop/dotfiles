# Google Calendar Web App
bind = $mod SHIFT, C, exec, chromium --profile-directory=Default --app-id=kjbdgfilnfhdoflbpgamdcdgpehopbep
# webmail.ondataport.de Web App
bind = $mod SHIFT, J, exec, chromium --profile-directory=Default --app-id=ghoplmdfocnckmbbjfgecbiadpjamnla
# bind = $mod, K, togglespecialworkspace, keepassx
bind = $mod, B, togglespecialworkspace, bitwarden

# Switch sound output device
