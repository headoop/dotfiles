# Hyprland Configuration
# https://wiki.hypr.land/Configuring/

# ==================
# MONITOR CONFIG
# ==================
# Monitors from existing configuration
# monitor = , preferred, auto, auto
# monitor = , preferred, auto, 1
# monitor = eDP-1, 1920x1080, 0x0, 1
# monitor = DP-1, 1920x1080, 1920x0, 1

{{ if eq .chezmoi.hostname "punk" }}
# punk
# Silent Power Electronics GmbH LC-M27UFD
# monitor = , 3840x2160@160.00, auto, 1.5
monitorv2 {
  output = HDMI-A-1
    mode = 3840x2160@160.00
    position = 0x0
    scale = 1.5
    transform = 0
}
#
{{ else if eq .chezmoi.hostname "ska" }}
# ska
monitor = eDP-1, 1920x1080, 0x0, 1
{{ else }}
# default
monitor = , preferred, auto, auto
{{ end }}

# ==================
# ENVIRONMENT VARS
# ==================
env = QT_QPA_PLATFORM,wayland
env = ELECTRON_OZONE_PLATFORM_HINT,auto
env = QT_QPA_PLATFORMTHEME,gtk3
env = QT_QPA_PLATFORMTHEME_QT6,gtk3
env = TERMINAL,kitty

# fix frozen doubled cursor
exec-once = sleep 2.5 && hyprctl dispatch movecursor 9999 9999
exec-once = sleep 3 && hyprctl dispatch movecursor 1280 720
env = WLR_NO_HARDWARE_CURSORS,1
env = WLR_RENDERER_ALLOW_SOFTWARE,1
exec-once = hyprctl dispatch dpms off
exec-once = sleep 2 && hyprctl dispatch dpms on
# end: fix frozen doubled cursor

exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user start hyprland-session.target

$terminal = uwsm app -- kitty
$fileManager = uwsm app -- nautilus --new-window
$browser = uwsm app -- firefox
$email = uwsm app -- betterbird

# ==================
# STARTUP APPS
# ==================
# dms is run via systemd --user service
# exec-once = dms run
exec-once = bash -c "wl-paste --watch cliphist store &"
exec-once = /usr/lib/mate-polkit/polkit-mate-authentication-agent-1

# exec-once = [workspace 1 silent] uwsm app -- firefox
exec-once = [workspace 1 silent] $browser
exec-once = [workspace 2 silent] uwsm app -- kitty --session ~/.config/kitty/startup-session.conf
# exec-once = [workspace 3 silent] uwsm app -- betterbird
exec-once = [workspace 3 silent] $email

# autstart keepassxc in special workspace
# exec-once = [workspace special:keepassx silent] uwsm app -- keepassxc
# exec-once = sleep 1; hyprctl dispatch togglespecialworkspace keepassx
# exec-once = [workspace special:bitwarden silent] bitwarden-desktop
exec-once = [workspace special:bitwarden] bash -c 'sleep 5 && bitwarden-desktop --ozone-platform=wayland'
# exec-once = [workspace special:bitwarden] uwsm app -- electron36 /usr/lib/bitwarden/app.asar
# exec-once = uwsm app -- bitwarden-desktop
exec-once = sleep 10; hyprctl dispatch togglespecialworkspace bitwarden

# autostart udiskie for automounting/removing of usb drives
exec-once = uwsm app -- udiskie --tray

# ==================
# INPUT CONFIG
# ==================
input {
    kb_layout = de,us
    kb_options = ctrl:nocaps,grp:alt_space_toggle
    numlock_by_default = true
    follow_mouse = 1
}

# ==================
# GENERAL LAYOUT
# ==================
general {
{{ if eq .chezmoi.hostname "punk" }}
    gaps_in = 20
    gaps_out = 20
{{ else }}
    gaps_in = 5
    gaps_out = 5
{{ end }}
    border_size = 0  # off in niri

    col.active_border = rgba(707070ff)
    # col.active_border = rgba(202020ff)
    col.inactive_border = rgba(d0d0d0ff)

    layout = dwindle
}

# ==================
# DECORATION
# ==================
decoration {
    rounding = 12

    active_opacity = 1.0
    inactive_opacity = 0.9

    shadow {
        enabled = true
        range = 30
        render_power = 5
        offset = 0 5
        color = rgba(00000070)
    }
}

# ==================
# ANIMATIONS
# ==================
animations {
    enabled = true

    animation = windowsIn, 1, 3, default
    animation = windowsOut, 1, 3, default
    animation = workspaces, 1, 5, default
    animation = windowsMove, 1, 4, default
    animation = fade, 1, 3, default
    animation = border, 1, 3, default
}

# ==================
# LAYOUTS
# ==================
dwindle {
    preserve_split = true
    force_split = 2 # Always split on the right
}

master {
    mfact = 0.5
}

# ==================
# MISC
# ==================
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    vrr = 1
    force_default_wallpaper = 0 # Set to 0 or 1 to disable the anime mascot wallpapers
}

# ==================
# WINDOW RULES
# ==================
# windowrulev2 = tile, class:^(org\.wezfurlong\.wezterm)$
# windowrulev2 = noborder, class:^(org\.wezfurlong\.wezterm)$
windowrule {
  name = windowrule-1
  tile = on
  border_size = 0
  match:class = ^(org\.wezfurlong\.wezterm)$
}

# windowrulev2 = rounding 12, class:^(org\.gnome\.)
# windowrulev2 = noborder, class:^(org\.gnome\.)
windowrule {
  name = windowrule-2
  rounding = 12
  border_size = 0
  match:class = ^(org\.gnome\.)
}

# windowrulev2 = tile, class:^(gnome-control-center)$
windowrule {
  name = windowrule-3
  tile = on
  match:class = ^(gnome-control-center)$
}

# windowrulev2 = tile, class:^(pavucontrol)$
windowrule {
  name = windowrule-4
  tile = on
  match:class = ^(pavucontrol)$
}

# windowrulev2 = tile, class:^(nm-connection-editor)$
windowrule {
  name = windowrule-5
  tile = on
  match:class = ^(nm-connection-editor)$
}

# windowrulev2 = float, class:^(gnome-calculator)$
windowrule {
  name = windowrule-6
  # size = (monitor_w*0.4) (monitor_h*0.3)
  size = (window_w*200/monitor_w) (window_h*200/monitor_h)
  float = on
  match:class = ^(org.gnome.Calculator)$
}

# windowrulev2 = float, class:^(galculator)$
windowrule {
  name = windowrule-7
  float = on
  match:class = ^(galculator)$
}

# windowrulev2 = float, class:^(blueman-manager)$
windowrule {
  name = windowrule-8
  float = on
  match:class = ^(blueman-manager)$
}

# windowrulev2 = float, class:^(org\.gnome\.Nautilus)$
# windowrule {
#   name = windowrule-666
#   float = on
#   match:class = ^(org\.gnome\.Nautilus)$
# }

# windowrulev2 = float, class:^(steam)$
windowrule {
  name = windowrule-9
  float = on
  match:class = ^(steam)$
}

# windowrulev2 = float, class:^(xdg-desktop-portal)$
windowrule {
  name = windowrule-10
  float = on
  match:class = ^(xdg-desktop-portal)$
}

# windowrulev2 = noborder, class:^(Alacritty)$
windowrule {
  name = windowrule-11
  border_size = 0
  match:class = ^(Alacritty)$
}

# windowrulev2 = noborder, class:^(zen)$
windowrule {
  name = windowrule-12
  border_size = 0
  match:class = ^(zen)$
}

# windowrulev2 = noborder, class:^(com\.mitchellh\.ghostty)$
windowrule {
  name = windowrule-13
  border_size = 0
  match:class = ^(com\.mitchellh\.ghostty)$
}

# windowrulev2 = noborder, class:^(kitty)$
windowrule {
  name = windowrule-14
  border_size = 0
  match:class = ^(kitty)$
}


# windowrulev2 = float, class:^(firefox)$, title:^(Picture-in-Picture)$
windowrule {
  name = windowrule-15
  float = on
  match:class = ^(firefox)$
  match:title = ^(Picture-in-Picture)$
}

# windowrulev2 = float, class:^(zoom)$
windowrule {
  name = windowrule-16
  float = on
  match:class = ^(zoom)$
}


# windowrulev2 = opacity 0.9 0.9, floating:0, focus:0
windowrule {
  name = windowrule-17
  opacity = 0.9 0.9
  match:float = 0
  match:focus = 0
}


# windowrulev2 = workspace special:keepassx, class:^(org.keepassxc.KeePassXC)$
# windowrule {
#   name = windowrule-18
#   workspace = special:keepassx
#   match:class = ^(org.keepassxc.KeePassXC)$
# }

# Thunderbird mail compose window floating
# windowrulev2 = float,class:^(thunderbird)$,initialTitle:^(Verfassen: \(Kein Betreff\))$
# windowrulev2 = float,class:^(eu.betterbird.Betterbird)$,initialTitle:^(Verfassen: \(Kein Betreff\))$

# windowrulev2 = float,class:^(eu.betterbird.Betterbird)$,initialTitle:^(Kalendererinnerungen)$
# windowrulev2 = size 40% 30%, class:^(eu.betterbird.Betterbird)$,initialTitle:^(Kalendererinnerungen)$
windowrule {
  name = windowrule-19
  float = on
  size = (monitor_w*0.4) (monitor_h*0.3)
  match:class = ^(eu.betterbird.Betterbird)$
  match:initial_title = ^(Kalendererinnerungen)$
}

# windowrulev2 = size 60% 50%, class:^(org.pulseaudio.pavucontrol)$
windowrule {
  name = windowrule-20
  size = (monitor_w*0.6) (monitor_h*0.5)
  match:class = ^(org.pulseaudio.pavucontrol)$
}

# windowrulev2 = float, class:^(firefox)$, title:^(Bild-im-Bild)$
# windowrulev2 = size 30%, class:^(firefox)$, title:^(Bild-im-Bild)$
# windowrulev2 = move 69% 69%, class:^(firefox)$, title:^(Bild-im-Bild)$
windowrule {
  name = windowrule-21
  float = on
  size = (monitor_w*0.3) (monitor_h*0.3)
  # move = ((monitor_w*0.69)) ((monitor_h*0.69))
  move = (monitor_w*0.69) (monitor_h*0.69)
  match:class = ^(firefox)$
  match:title = ^(Bild-im-Bild)$
}

# windowrulev2 = focusonactivate, class:.*
windowrule {
  name = windowrule-22
  focus_on_activate = on
  match:class = .*
}

windowrule {
  name = windowrule-23
  workspace = special:bitwarden
  match:class = ^(Bitwarden)$
}

# layerrule = noanim, ^(quickshell)$
layerrule {
  name = layerrule-1
  no_anim = on
  match:namespace = ^(quickshell)$
}

layerrule {
  name = layerrule-2
  no_anim = on
  match:namespace = ^(dms)$
}

