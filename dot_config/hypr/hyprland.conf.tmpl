bind = $mod, T, exec, $terminal
bind = $mod, RETURN, exec, $terminal
bind = $mod, E, exec, $fileManager
bind = $mod CTRL, return, exec, $email
bind = $mod SHIFT, M, exec, music.sh
bind = $mod, XF86HomePage, exec, uwsm app -- joplin-desktop

