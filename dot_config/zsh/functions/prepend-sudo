# https://justingarrison.com/blog/2020-05-28-shell-shortcuts/

[[ -z $BUFFER ]] && zle up-history
if [[ $BUFFER == sudo\ * ]]; then
  LBUFFER="${LBUFFER#sudo }"
else
  LBUFFER="sudo $LBUFFER"
fi

