source ~/.config/neomutt/muttrc
set from                  = {{ pass "mail-google-main/email" }}
set realname              = {{ pass "mail-google-main/name" }}
set status_format         = "-%r-NeoMutt: %D [Msgs:%<M?%M/>%m%<n? New:%n>%<o? Old:%o>%<d? Del:%d>%<F? Flag:%F>%<t? Tag:%t>%<p? Post:%p>%<b? Inc:%b>%<l? %l>]---(%<T?%T/>%s/%S)-%>-(%P)---"
set index_format          = "%4C %Z %{%b %d} %-15.15L (%?l?%4l&%4c?) %s"
set date_format           = "%a, %b %d, %Y at %I:%M:%S%p %Z"
set imap_user             = {{ pass "mail-google-main/email" }}
set imap_pass             = "`pass show "mail-google-main/email"`"
set imap_check_subscribed
unset imap_passive
set folder                = imaps://{{ pass "mail-google-main/email" }}@imap.gmail.com
set spoolfile             = =INBOX
set postponed             = "=[Google Mail]/Entwürfe"
# set postponed = "+[Gmail].Drafts"
unset record
unset trash
# folder-hook . "macro index d '<save-message>=[Google Mail]/Papierkorb<enter>'"
# folder-hook "=[Google Mail]/Papierkorb" 'macro index d <delete-message>'
# folder-hook . 'macro index d "<save-message>=Trash<enter>"'
# folder-hook =Trash 'macro index d <delete-message>'
set smtp_pass             = $imap_pass
set ssl_force_tls         = yes
set smtp_url              = smtp://$imap_user@smtp.gmail.com:587
set ssl_starttls          = yes
