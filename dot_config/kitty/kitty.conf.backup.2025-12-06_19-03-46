font_size                   11.0
draw_minimal_borders        yes
window_padding_width        0
window_margin_width         0
single_window_margin_width  0
dynamic_background_opacity  yes
# background_opacity          0.95
background_opacity          0.8
background_tint             0.5
tab_bar_edge                top
#tab_bar_style               powerline
# tab_bar_style               fade
tab_bar_style               separator
tab_separator               " "
#tab_bar_style               slant
tab_title_template          " {index} {title} "
enable_audio_bell           no
update_check_interval       0
# need for zen-mode (nvim)
# allow_remote_control no
allow_remote_control socket-only
listen_on unix:/tmp/kitty
# end # need for zen-mode (nvim)
scrollback_lines 8192
inactive_text_alpha 0.7
hide_window_decorations yes
mouse_hide_wait 3.0

#: You can also create shortcuts to switch to specific layouts::
map ctrl+alt+t goto_layout tall
map ctrl+alt+s goto_layout stack
#: Similarly, to switch back to the previous layout::
map ctrl+alt+p last_used_layout

# I do window handling with i3, so can use kittys
# window shortcuts for handling tabs
map ctrl+alt+right next_tab
# map ctrl+tab next_tab  # default
map ctrl+alt+left previous_tab
# map kitty_mod+tab previous_tab  # default
map ctrl+alt+1 goto_tab 1
map ctrl+alt+KP_1 goto_tab 1
map ctrl+alt+2 goto_tab 2
map ctrl+alt+KP_2 goto_tab 2
map ctrl+alt+3 goto_tab 3
map ctrl+alt+KP_3 goto_tab 3
map ctrl+alt+4 goto_tab 4
map ctrl+alt+KP_4 goto_tab 4
map ctrl+alt+5 goto_tab 5
map ctrl+alt+KP_5 goto_tab 5
map ctrl+alt+6 goto_tab 6
map ctrl+alt+KP_6 goto_tab 6
map ctrl+alt+7 goto_tab 7
map ctrl+alt+KP_7 goto_tab 7
map ctrl+alt+8 goto_tab 8
map ctrl+alt+KP_8 goto_tab 8
map ctrl+alt+9 goto_tab 9
map ctrl+alt+KP_9 goto_tab 9
map ctrl+alt+0 goto_tab 0
map ctrl+alt+KP_0 goto_tab 0

map ctrl+F5 launch --location=hsplit
map ctrl+F6 launch --location=vsplit
map ctrl+F7 layout_action rotate

# switch to layout 'stack' or back to the previous layout when
# in layout 'stack' (which gives a zoom feature)
map ctrl+shift+z toggle_layout stack
# scroll_to_prompt -1 ist originally mapped to ctrl+shift+z
# which is now used to toggle layout 'stack'
map ctrl+alt+z scroll_to_prompt -1
map ctrl+alt+x scroll_to_prompt 1

# map ctrl+alt+enter          launch --cwd=current
map ctrl+alt+enter          new_window_with_cwd

map ctrl+shift+alt+up       move_window up
map ctrl+shift+alt+left     move_window left
map ctrl+shift+alt+right    move_window right
map ctrl+shift+alt+down     move_window down

map shift+left  neighboring_window left
map shift+right neighboring_window right
map shift+up    neighboring_window up
map shift+down  neighboring_window down

map kitty_mod+1 first_window
map kitty_mod+2 second_window
map kitty_mod+3 third_window
map kitty_mod+4 fourth_window
map kitty_mod+5 fifth_window
map kitty_mod+6 sixth_window
map kitty_mod+7 seventh_window
map kitty_mod+8 eighth_window
map kitty_mod+9 ninth_window
map kitty_mod+0 tenth_window

# Scrolling
map kitty_mod+up        scroll_line_up
map kitty_mod+down      scroll_line_down
map shift+page_up       scroll_page_up
map shift+page_down     scroll_page_down
map kitty_mod+home      scroll_home
map kitty_mod+end       scroll_end
map kitty_mod+h         show_scrollback

# fontsize
map kitty_mod+plus      change_font_size all +1.0
map kitty_mod+minus     change_font_size all -1.0
map kitty_mod+backspace change_font_size all 0

# select theme with 'kitty +kitten themes'
# include Ubuntu.conf
#include Afterglow.conf
#include Gruvbox Dark Hard.conf
# include Jellybeans.conf
# include Catppuccin-Mocha.conf
# include Ayu.conf

# BEGIN_KITTY_THEME
# Adwaita darker
include current-theme.conf
# END_KITTY_THEME

